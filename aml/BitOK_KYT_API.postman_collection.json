	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {
					"npm:crypto-js@4.2.0": {
						"id": "npm:crypto-js@4.2.0"
					}
				},
				"exec": [
					"const CryptoJS = require('crypto-js');",
					"const ts = Date.now().toString();",
					"const api_key_id = pm.environment.get(\"API_KEY_ID\");",
					"const api_secret = pm.environment.get(\"API_KEY_SECRET\");",
					"",
					"pm.request.headers.add({",
					"    key: \"API-TIMESTAMP\",",
					"    value: ts",
					"});",
					"",
					"pm.request.headers.add({",
					"    key: \"API-KEY-ID\",",
					"    value: api_key_id",
					"});",
					"",
					"let paramsObject = {};",
					"",
					"let str_to_sign = ",
					"        pm.request.method + \"\\n\" +",
					"        pm.request.url.getPathWithQuery() + \"\\n\" +",
					"        ts;",
					"",
					"let body_row = pm.request.body.raw",
					"",
					"if (pm.request.method == \"POST\" && body_row !== undefined) {",
					"    str_to_sign += \"\\n\" +",
					"        JSON.stringify(JSON.parse(body_row));",
					"    ",
					"}",
					"",
					"console.log(str_to_sign);",
					"",
					"var signature = CryptoJS.HmacSHA256(str_to_sign, api_secret).toString(CryptoJS.enc.Base64);",
					"        ",
					"Object.assign(paramsObject, {'timestamp': ts});",
					"console.log(signature);",
					"",
					"if (signature) {",
					"",
					"    pm.request.headers.add({",
					"        key: \"API-SIGNATURE\",",
					"        value: signature",
					"    });",
					"}"
				]
			}
		},
